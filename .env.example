# ==============================================================================
# ORACLE CLOUD ALWAYS FREE - DOCKER COMPOSE CONFIGURATION TEMPLATE
# ==============================================================================

# Database Passwords (use strong randomly generated strings)
MYSQL_ROOT_PASSWORD=GenerateStrongRootPassword2026!
MYSQL_PASSWORD=GenerateStrongAppPassword2026!

# JWT Secret for Session Authentication (minimum 32 characters)
JWT_SECRET=GenerateRandom64CharacterSecretKeyHereForProduction2026

# Public HTTP Port (80 for standard Oracle Cloud VM, 8080 for local test)
HTTP_PORT=80

# Public Domain or VM Public IP
FRONTEND_URL=http://your-oracle-vm-public-ip
