# ==============================================================================
# COMMUNITY HALL MANAGEMENT SYSTEM - ENVIRONMENT TEMPLATE
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Frontend URL(s) allowed for CORS (comma-separated if multiple domains)
FRONTEND_URL=https://your-frontend-domain.com
ADDITIONAL_ALLOWED_ORIGINS=

# Database Connection (Supabase PostgreSQL)
# DATABASE_URL: Transaction Pooler connection (Port 6543, pgbouncer=true) for application runtime queries
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct / Session connection (Port 5432) for Prisma schema migrations & DDL operations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Security & JSON Web Tokens
# Generate a strong 64-character secret using: openssl rand -base64 48
JWT_SECRET=your_production_long_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ElevenLabs Conversational AI Receptionist (Optional / Integration)
# Obtain your API key from ElevenLabs Dashboard -> Profile -> API Keys
ELEVENLABS_API_KEY=
# Obtain your Agent ID from Conversational AI -> Agent Settings
ELEVENLABS_AGENT_ID=
# Optional: Specific branch ID if working with branches
ELEVENLABS_BRANCH_ID=
